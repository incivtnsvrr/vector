#include <iostream>
#include <vector>
using namespace std;
int main() {

	cout << "Satır Sayısını giriniz..\n";
	int satir;
	cin >> satir;
	cout << "Sütun Sayısını giriniz..\n";
	int sutun;
	cin >> sutun;

	vector<vector<double>> matris;

	matris.resize(satir);

	for (int i = 0; i < satir; i++) {
		matris[i].resize(sutun); 
	}


	for (int i = 0; i < satir; i++) {
		for (int j = 0; j < sutun; j++) {
			std::cout << "matris [" << i << "] [" << j << "] Değerini girin..\n";
			double deger;
			std::cin >> deger;
			matris[i][j] = deger;
		}
	}

	std::cout << "Matris Değeri" << std::endl;

	
	for (int i = 0; i < satir; i++) {
		for (int j = 0; j < sutun; j++) {
			std::cout << matris[i][j] << "\t";
		}
		std::cout << std::endl;
	}
}
